{
  "host": "smtp.logihertz.com",
  "port": 587,
  "tls_mode": "starttls",
  "allow_plaintext": false,
  "verify_peer": true,
  "socket_timeout_seconds": 30,
  "max_messages_per_connection": 100,
  "max_message_size_bytes": 10485760,
  "username": "mail_gateway",
  "password": "env:SMTP_PASSWORD",
  "strict_header_sanitization": true,
  "validate_reply_to": true,
  "validate_return_path": true,
  "dkim_enabled": true,
  "dkim_domain": "logihertz.com",
  "dkim_selector": "sig2026",
  "dkim_key_bits": 2048,
  "dkim_hash_algorithm": "rsa-sha256",
  "signed_headers": [
    "from",
    "to",
    "subject",
    "date",
    "message-id",
    "mime-version",
    "content-type"
  ],
  "spf_record": "v=spf1 include:_spf.logihertz.com -all",
  "dmarc_record": "v=DMARC1; p=reject; sp=reject; rua=mailto:dmarc-reports@logihertz.com; pct=100; aspf=s; adkim=s",
  "bounce_alignment": true,
  "envelope_alignment": true,
  "require_one_click_unsubscribe": true,
  "list_unsubscribe_post": true
}
